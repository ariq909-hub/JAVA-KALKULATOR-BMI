<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.kalkulatorbmijava.BMIController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Kalkulator BMI (Body Mass Index)">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <TextField fx:id="txtBerat" promptText="Berat Badan (kg)" />
      <TextField fx:id="txtTinggi" promptText="Tinggi Badan (cm)" />
      <Button fx:id="btnHitung" onAction="#hitungBMI" text="Hitung BMI" />
      <Label fx:id="lblHasilBMI" text="Hasil BMI: -">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label fx:id="lblKategori" text="Kategori: -">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
   </children>
</VBox>